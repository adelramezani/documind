[Unit]
Description=Documind FastAPI backend
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory={{ app_dir }}/app
EnvironmentFile={{ app_dir }}/documind.env
ExecStart={{ app_dir }}/venv/bin/uvicorn app.main:app --app-dir backend --host {{ app_host }} --port {{ app_port }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
